lumn;gap: 10px;font-size: 0.94rem}\n\n    .plan li {position: relative;padding-left: 18px}\n\n    .plan li::before {content: \"\";position: absolute;left: 0;top: 0.72em;width: 9px;height: 2px;background: currentColor}\n\n    .plan-foot {margin-top: auto;font-size: 0.78rem;letter-spacing: 0.06em;opacity: 0.78;border-top: 1px solid currentColor;padding-top: 12px}\n\n    /* 客户端 */\n    .clients-grid {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 28px}\n\n    .client-card {border: 3px solid var(--rule);padding: 26px 24px;background: #fffdf6;display: flex;flex-direction: column;gap: 12px}\n\n    .client-card h3 {margin: 0;font-size: 1.2rem;display: flex;justify-content: space-between;align-items: baseline;gap: 12px;border-bottom: 2px solid var(--rule);padding-bottom: 10px}\n\n    .client-card h3 span {font-size: 0.7rem;letter-spacing: 0.12em;text-transform: uppercase;color: var(--wine);white-space: nowrap}\n\n    .client-card p {margin: 0;font-size: 0.94rem;color: var(--ink-soft)}\n\n    .client-card .status {font-size: 0.8rem;letter-spacing: 0.04em;color: var(--ink-soft);border-top: 1px dashed var(--ink-soft);padding-top: 10px;margin-top: auto}\n\n    /* 使用说明 */\n    .steps {counter-reset: step;display: grid;gap: 0;border-top: 2px solid var(--rule)}\n\n    .step {counter-increment: step;display: grid;grid-template-columns: 72px minmax(0, 1fr);gap: 24px;padding: 26px 0;border-bottom: 2px solid var(--rule);align-items: start}\n\n    .step::before {content: counter(step, decimal-leading-zero);font-size: 2rem;line-height: 1;color: var(--wine);letter-spacing: 0.02em}\n\n    .step h3 {margin: 0 0 6px;font-size: 1.1rem}\n\n    .step p {margin: 0;color: var(--ink-soft);font-size: 0.96rem;max-width: 760px}\n\n    /* FAQ 按主题分组 */\n    .faq-groups {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 44px 52px}\n\n    .faq-group h3 {margin: 0 0 6px;font-size: 0.78rem;letter-spacing: 0.2em;text-transform: uppercase;color: var(--wine)}\n\n    .faq-group > p {margin: 0 0 20px;font-size: 0.9rem;color: var(--ink-soft);border-bottom: 2px solid var(--rule);padding-bottom: 10px}\n\n    .faq-list {display: flex;flex-direction: column;gap: 18px}\n\n    .faq-item {border-left: 3px solid var(--wine);padding-left: 18px}\n\n    .faq-item h4 {margin: 0 0 6px;font-size: 1rem;line-height: 1.45}\n\n    .faq-item p {margin: 0;color: var(--ink-soft);font-size: 0.94rem}\n\n    .closing {border-top: 3px solid var(--wine-deep);background: var(--wine);color: var(--ivory);padding: 64px;display: grid;grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.7fr);gap: 44px;align-items: center}\n\n    .closing h2 {margin: 0 0 14px;font-size: clamp(1.6rem, 2.8vw, 2.3rem);line-height: 1.25}\n\n    .closing p {margin: 0;color: rgba(251, 246, 234, 0.86);max-width: 620px}\n\n    .closing-note {border: 3px solid var(--ivory);padding: 24px;font-size: 0.92rem;line-height: 1.7;color: rgba(251, 246, 234, 0.92)}\n\n    footer {padding: 26px 64px 34px;font-size: 0.8rem;color: var(--ink-soft);display: flex;flex-wrap: wrap;gap: 8px 24px;justify-content: space-between;border-top: 2px solid var(--rule)}\n\n    @media (max-width: 1024px) {\n      .layout {grid-template-columns: 1fr}\n\n      .side-nav {position: static;height: auto;flex-direction: row;flex-wrap: wrap;align-items: center;gap: 18px 32px;padding: 20px 28px;border-right: 0;border-bottom: 3px solid var(--wine-deep)}\n\n      .side-mark span {display: inline;margin-left: 8px}\n\n      .side-nav nav ul {flex-direction: row;flex-wrap: wrap;gap: 4px 16px}\n\n      .side-nav nav a {padding: 6px 0;border-left: 0;border-bottom: 2px solid transparent}\n\n      .side-nav nav a:hover,\n      .side-nav nav a:focus-visible {padding-left: 0;border-left-color: transparent;border-bottom-color: var(--accent)}\n\n      .side-note {display: none}\n\n      .band {padding: 46px 36px}\n\n      .band-mid {grid-template-columns: 1fr;gap: 28px}\n\n      .band-bottom {grid-template-columns: 1fr;gap: 20px}\n\n      section,\n      .closing {padding: 54px 36px}\n\n      .plans {grid-template-columns: 1fr;border: 3px solid var(--rule)}\n\n      .plan {border-right: 0;border-bottom: 3px solid var(--rule)}\n\n      .plan:last-child {border-bottom: 0}\n\n      .plan.step-1,\n      .plan.step-2,\n      .plan.step-3 {margin-top: 0}\n\n      .clients-grid,\n      .faq-groups {grid-template-columns: 1fr}\n\n      .closing {grid-template-columns: 1fr}\n\n      footer {padding: 24px 36px 30px}\n    }\n\n    @media (max-width: 600px) {\n      .band {padding: 38px 22px}\n\n      .band-top {padding-bottom: 46px}\n\n      .band-bottom {padding-top: 34px;padding-bottom: 46px}\n\n      section,\n      .closing {padding: 44px 22px}\n\n      .step {grid-template-columns: 1fr;gap: 10px}\n\n      .section-head {flex-direction: column;align-items: flex-start;gap: 6px}\n\n      .side-nav {padding: 18px 22px}\n\n      footer {padding: 22px}\n    }\n  </style><div class=\"layout\">\n    <aside class=\"side-nav\">\n      <div class=\"side-mark\">\n        BASHBORAD\n        <span>使用手册与套餐说明</span>\n      </div>\n      <nav aria-label=\"页面目录\">\n        <ul>\n          <li><a href=\"#overview\">先聊两句</a></li>\n          <li><a href=\"#plans\">套餐怎么选</a></li>\n          <li><a href=\"#clients\">客户端与设备</a></li>\n          <li><a href=\"#guide\">使用步骤</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </nav>\n      <div class=\"side-note\">\n        这是一份静态说明页。价格、权益和客户端信息都写在下面，没有放下载按钮，也没有放外部跳转链接。\n      </div>\n    </aside>\n\n    <main>\n      <header class=\"hero\">\n        <div class=\"band band-top\">\n          <p class=\"kicker\">BASHBORAD · 订阅说明</p>\n          <h1>BASHBORAD<br>不急着买，先看看怎么用。</h1>\n          <p class=\"hero-lede\">\n            我们把套餐、设备数量、使用步骤和常见问题整理成一页，尽量写得像朋友在边上给你讲一遍。\n            <strong>价格与权益以本页文字为准</strong>，没有隐藏入口，也没有绕来绕去的说明。\n          </p>\n        </div>\n\n        <div class=\"band band-mid\">\n          <div>\n            <h2>先想清楚：你是一个人用，还是一家人、一个小组一起用？</h2>\n            <p>\n              套餐按设备数量和每月流量分成三档，适合的场景不同。基础版适合单人或双人日常；旗舰版给设备多、又常用流媒体和游戏的人；团队版则偏向多人共享、需要更宽裕额度的情况。\n            </p>\n          </div>\n          <div class=\"hero-stat\" aria-label=\"套餐档位提示\">\n            <span class=\"label\">三档阶梯</span>\n            <span class=\"value\">15 / 35 / 85 元每月</span>\n          </div>\n        </div>\n\n        <div class=\"band band-bottom\">\n          <article>\n            <h3>按月还是按年，先按自己的节奏来</h3>\n            <p>月付适合先试一段时间，年付会在页面上单独标出价格。两种方式都可以，无需一次就决定长期。</p>\n          </article>\n          <article>\n            <h3>设备数量写得很清楚</h3>\n            <p>基础版 3 台、旗舰版 5 台、团队版 20 台同时在线。这里的数字是套餐权益的一部分，不是泛指。</p>\n          </article>\n          <article>\n            <h3>按主题找答案</h3>\n            <p>常见问题分成套餐、设备、使用和售后四组，你可以直接跳到关心的那一组，不用通读整页。</p>\n          </article>\n        </div>\n      </header>\n\n      <section id=\"overview\">\n        <div class=\"section-head\">\n          <span class=\"index\">01 / 先聊两句</span>\n          <h2>这页说明适合谁看</h2>\n        </div>\n        <ul class=\"quick-links\">\n          <li><a href=\"#plans\">直接看套餐</a></li>\n          <li><a href=\"#clients\">先看设备支持</a></li>\n          <li><a href=\"#guide\">看使用步骤</a></li>\n          <li><a href=\"#faq\">跳到常见问题</a></li>\n        </ul>\n        <div class=\"intro-copy\">\n          <p>\n            如果你刚听说 BASHBORAD，最想知道的大概是：我能用几台设备、每月多少流量、一年下来大概多少钱。这些信息都在下面，按阶梯排开，不藏在小字里。\n          </p>\n          <p>\n            如果你已经在用，想确认某个权益或者某个客户端怎么操作，可以跳过套餐部分，直接去“客户端与设备”或“常见问题”看看。页面没有放下载地址，也没有放购买按钮，所有链接都是页内锚点，这样阅读的时候不会被带到别处。\n          </p>\n          <p>\n            我们尽量使用直接的说法：多少钱、多少台设备、多少流量、什么支持方式。没有“极速稳定”“一键连接”“全球加速”这类词，因为这些话解决不了你实际的疑问。\n          </p>\n        </div>\n      </section>\n\n      <section id=\"plans\">\n        <div class=\"section-head\">\n          <span class=\"index\">02 / 套餐怎么选</span>\n          <h2>三档阶梯，从够用到宽裕</h2>\n        </div>\n        <div class=\"plans\">\n          <article class=\"plan step-1\">\n            <span class=\"plan-tag\">基础版</span>\n            <h3>够用、不折腾</h3>\n            <div class=\"price\">\n              <span class=\"amount\">¥15</span>\n              <span class=\"cycle\">/ 月</span>\n            </div>\n            <p class=\"annual\">按年付 ¥150 / 年</p>\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <div class=\"plan-foot\">适合单人日常、轻量使用</div>\n          </article>\n\n          <article class=\"plan step-2\">\n            <span class=\"plan-tag\">旗舰版 · 推荐</span>\n            <h3>设备多、场景全</h3>\n            <div class=\"price\">\n              <span class=\"amount\">¥35</span>\n              <span class=\"cycle\">/ 月</span>\n            </div>\n            <p class=\"annual\">按年付 ¥350 / 年</p>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n            <div class=\"plan-foot\">适合多设备、常看流媒体或玩游戏的人</div>\n          </article>\n\n          <article class=\"plan step-3\">\n            <span class=\"plan-tag\">团队版</span>\n            <h3>给一群人留足空间</h3>\n            <div class=\"price\">\n              <span class=\"amount\">¥85</span>\n              <span class=\"cycle\">/ 月</span>\n            </div>\n            <p class=\"annual\">按年付 ¥850 / 年</p>\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <div class=\"plan-foot\">适合小组、工作室或多设备共享</div>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"clients\">\n        <div class=\"section-head\">\n          <span class=\"index\">03 / 客户端与设备</span>\n          <h2>你手里的设备，先对号入座</h2>\n        </div>\n        <div class=\"clients-grid\">\n          <article class=\"client-card\">\n            <h3>桌面端 <span>电脑 / 笔记本</span></h3>\n            <p>适合在电脑上浏览网页、看流媒体或处理日常事务。安装后按客户端里的提示填入订阅信息即可。页面不提供直接下载地址，请从你获得服务的渠道获取安装包。</p>\n            <p class=\"status\">说明：本页不放置外部下载链接，避免引导到不确定地址。</p>\n          </article>\n\n          <article class=\"client-card\">\n            <h3>移动端 <span>手机 / 平板</span></h3>\n            <p>在手机上使用时，注意套餐里的“同时在线设备数”是指同一时间在线的设备，不是安装过的设备总数。基础版 3 台、旗舰版 5 台、团队版 20 台。</p>\n            <p class=\"status\">说明：应用商店或安装包来源以你实际获得服务的渠道为准。</p>\n          </article>\n\n          <article class=\"client-card\">\n            <h3>路由器 / 共享场景 <span>多人环境</span></h3>\n            <p>如果多人共享，建议先核算在线设备数。团队版提供 20 台同时在线与更宽裕的流量额度，适合小团队或家庭多人使用。企业定制路由权益包含在团队版内。</p>\n            <p class=\"status\">说明：本页不承诺具体路由器型号或兼容性，请以实际客户端说明为准。</p>\n          </article>\n\n          <article class=\"client-card\">\n            <h3>支持方式 <span>工单与优先队列</span></h3>\n            <p>旗舰版与团队版分别包含 7x24 优先工单支持和专属客户经理服务。基础版可使用常规支持渠道。提交问题时写清楚设备、套餐和现象，回复会更快。</p>\n            <p class=\"status\">说明：支持范围以上述套餐权益文字为准，不额外承诺响应时间。</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"guide\">\n        <div class=\"section-head\">\n          <span class=\"index\">04 / 使用步骤</span>\n          <h2>从选套餐到顺畅使用，四步就够</h2>\n        </div>\n        <div class=\"steps\">\n          <article class=\"step\">\n            <div>\n              <h3>先确定设备数量和每月流量</h3>\n              <p>算一下同一时间会在线几台设备、一个月大概用多少流量。基础版 3 台、旗舰版 5 台、团队版 20 台；流量分别是 100GB、300GB 和 1000GB。按自己的实际习惯选，不用追高。</p>\n            </div>\n          </article>\n\n          <article class=\"step\">\n            <div>\n              <h3>拿到订阅信息后，在客户端里填写</h3>\n              <p>订阅信息以你实际获得的渠道为准。本页不展示订阅地址、二维码或下载入口，也不要求你在这里填写任何表单。请在你使用服务的环境中完成配置。</p>\n            </div>\n          </article>\n\n          <article class=\"step\">\n            <div>\n              <h3>按设备类型安装对应客户端</h3>\n              <p>电脑、手机、平板或路由器共享场景，使用的客户端形式可能不同。安装后先确认在线设备数没有超过套餐上限，再继续日常使用。</p>\n            </div>\n          </article>\n\n          <article class=\"step\">\n            <div>\n              <h3>遇到问题，按主题找答案或提交工单</h3>\n              <p>先看下面的常见问题，套餐权益、设备数、流媒体和游戏相关的说明都在那里。如果还是没解决，旗舰版和团队版可通过优先工单渠道提交；基础版走常规支持即可。</p>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"faq\">\n        <div class=\"section-head\">\n          <span class=\"index\">05 / 常见问题</span>\n          <h2>按主题分组，找答案快一点</h2>\n        </div>\n\n        <div class=\"faq-groups\">\n          <div class=\"faq-group\">\n            <h3>套餐与价格</h3>\n            <p>先看钱和额度，再决定要不要往下读。</p>\n            <div class=\"faq-list\">\n              <article class=\"faq-item\">\n                <h4>三档套餐的核心差别是什么？</h4>\n                <p>基础版每月 100GB、3 台设备在线；旗舰版每月 300GB、5 台设备在线，并包含全节点原生流媒体解锁、IPLC 专线游戏加速优化和 7x24 优先工单支持；团队版每月 1000GB、20 台设备在线，包含 VIP 专属高带宽节点、企业定制路由和专属客户经理服务。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>年付价格怎么算？</h4>\n                <p>基础版按年付 ¥150 / 年，旗舰版 ¥350 / 年，团队版 ¥850 / 年。页面同时标了月付价格，方便你对比。没有额外隐藏费用，也没有在本页放置促销倒计时。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>可以先月付，之后再换年付吗？</h4>\n                <p>本页只说明套餐价格与权益，不涉及具体变更流程。你可以按自己的使用节奏先选月付，是否切换年付以及如何切换，请以你实际获得服务的渠道说明为准。</p>\n              </article>\n            </div>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>设备与在线数量</h3>\n            <p>设备数按“同时在线”计算，避免误解。</p>\n            <div class=\"faq-list\">\n              <article class=\"faq-item\">\n                <h4>“3 台设备同时在线”是什么意思？</h4>\n                <p>指同一时间最多有 3 台设备处于在线使用状态。安装过但没在线的设备不计入同时在线数量。旗舰版对应 5 台，团队版对应 20 台。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>手机和电脑可以算在同一台额度里吗？</h4>\n                <p>可以这样理解：套餐限制的是同时在线设备总数，不区分手机、电脑或平板。你只需要注意同一时间在线的设备不要超过所选套餐的上限。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>路由器共享算几台设备？</h4>\n                <p>路由器本身和通过它接入的设备如何计数，取决于实际客户端的使用方式。本页不承诺具体路由器型号或计数细节，建议先按在线设备总数控制在套餐上限内来规划。</p>\n              </article>\n            </div>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>流媒体、游戏与线路</h3>\n            <p>把场景和权益对应起来看。</p>\n            <div class=\"faq-list\">\n              <article class=\"faq-item\">\n                <h4>基础版能看流媒体吗？</h4>\n                <p>基础版包含“解锁基础流媒体”，旗舰版和团队版则包含“全节点原生流媒体解锁”。如果你主要用流媒体，且希望节点覆盖更完整，建议从旗舰版看起。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>游戏加速在哪一档？</h4>\n                <p>旗舰版包含 IPLC 专线游戏加速优化。基础版写的是普通线路节点池，团队版写的是 VIP 专属高带宽节点。不同套餐的线路描述不同，按你常玩的场景选择。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>团队版的企业定制路由具体是什么？</h4>\n                <p>团队版权益里写明“支持企业定制路由”，并配有专属客户经理服务。这属于团队版套餐权益的一部分。本页不展开具体配置细节，也不承诺特定网络环境下的表现。</p>\n              </article>\n            </div>\n          </div>\n\n          <div class=\"faq-group\">\n            <h3>支持与页面说明</h3>\n            <p>关于本页能做什么、不能做什么。</p>\n            <div class=\"faq-list\">\n              <article class=\"faq-item\">\n                <h4>为什么页面上没有下载按钮和购买链接？</h4>\n                <p>这是一份静态说明页，只负责把套餐、客户端和使用步骤写清楚。没有可靠的下载地址或购买入口时，我们不放置外部链接，也不做引导。页面内所有链接都是页内锚点。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>支持范围怎么理解？</h4>\n                <p>旗舰版包含 7x24 优先工单支持，团队版包含专属客户经理服务，基础版使用常规支持渠道。这是套餐权益文字，不额外承诺具体响应时间、退款政策或日志能力。</p>\n              </article>\n              <article class=\"faq-item\">\n                <h4>本页是否代表品牌官方身份？</h4>\n                <p>本页是品牌信息说明页，内容围绕你提供的套餐与权益展开。没有提供的信息，例如官方认证身份、具体节点数量、性能数据或评价，我们不会编造或暗示。</p>\n              </article>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"closing\">\n        <div>\n          <h2>不用急着决定，先把这一页看完。</h2>\n          <p>\n            BASHBORAD 的套餐说明就摆在上面：基础版、旗舰版、团队版，月付和年付价格都写清楚了，设备数量和流量额度也直接列在卡片里。如果你只关心一个问题，跳到对应主题的常见问题就行。\n          </p>\n        </div>\n        <div class=\"closing-note\">\n          本页没有表单、没有外部跳转、没有下载入口。套餐、客户端与常见问题的文字均直接写在页面中，按需查看即可。\n        </div>\n      </section>\n\n      <footer>\n        <span>BASHBORAD · 静态说明页</span>\n        <span>套餐与权益以本页正文为准</span>\n      </footer>\n    </main>\n  </div>",
